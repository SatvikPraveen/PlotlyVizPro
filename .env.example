# ==============================================
# PlotlyVizPro Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==============================================
# Mapbox Configuration (Optional)
# ==============================================
# Get your free token at https://www.mapbox.com/
# Required for premium Mapbox features in Notebook 08
MAPBOX_TOKEN=your_mapbox_token_here

# ==============================================
# Application Settings
# ==============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# ==============================================
# Paths Configuration
# ==============================================
# Customize export directories if needed
EXPORT_HTML_DIR=exports/html
EXPORT_IMAGES_DIR=exports/images
DATASETS_DIR=datasets

# ==============================================
# Jupyter Configuration
# ==============================================
# Jupyter Lab port
JUPYTER_PORT=8888

# Auto-open browser
JUPYTER_AUTO_OPEN=true

# ==============================================
# Streamlit Configuration
# ==============================================
# Streamlit port
STREAMLIT_PORT=8501

# Theme settings
STREAMLIT_THEME_PRIMARY_COLOR=#56B4E9
STREAMLIT_THEME_BG_COLOR=#0E1117

# ==============================================
# Data Generation Settings
# ==============================================
# Random seed for reproducible datasets
RANDOM_SEED=42

# Number of rows for generated datasets
DATASET_SIZE=1000

# ==============================================
# Plotting Defaults
# ==============================================
# Default Plotly template
DEFAULT_PLOTLY_TEMPLATE=plotly_white

# Default figure size
DEFAULT_FIGURE_WIDTH=1200
DEFAULT_FIGURE_HEIGHT=600

# Export DPI for PNG
EXPORT_DPI=300

# ==============================================
# Database Configuration (Optional)
# ==============================================
# If you extend the project to use a database
# DATABASE_URL=postgresql://user:password@localhost:5432/plotlyvizpro
# DATABASE_URL=sqlite:///plotlyvizpro.db

# ==============================================
# API Keys (Optional)
# ==============================================
# Add any other API keys you might need
# ALPHA_VANTAGE_KEY=your_key_here
# WEATHER_API_KEY=your_key_here

# ==============================================
# Performance Settings
# ==============================================
# Maximum rows to display in plots
MAX_PLOT_ROWS=50000

# Cache timeout (seconds)
CACHE_TIMEOUT=3600

# ==============================================
# Logging Configuration
# ==============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/plotlyvizpro.log

# ==============================================
# Security (Production)
# ==============================================
# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=your_secret_key_here

# Allowed hosts (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
