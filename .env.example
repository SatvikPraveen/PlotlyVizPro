# PlotlyVizPro environment variables. Copy to .env (never commit it).

# Root directory for save_figure / save_fig_as_* (default: <project>/exports)
PLOTLYVIZPRO_EXPORT_DIR=exports

# Streamlit (see .streamlit/config.toml for theme settings)
STREAMLIT_SERVER_PORT=8501

# JupyterLab
JUPYTER_PORT=8888
